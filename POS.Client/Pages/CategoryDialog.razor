<div class="d-flex align-center gap-3 mb-4">
    <div class="pos-dialog-icon">
        <MudIcon Icon="@Icons.Material.Filled.Category" />
    </div>
    <div>
        <MudText Typo="Typo.overline" Class="pos-kicker">Catálogo</MudText>
        <MudText Typo="Typo.h6" Class="pos-dialog-title">@(Category.Id == 0 ? "Nueva categoría" : "Editar categoría")</MudText>
    </div>
</div>

<MudForm Model="@Category">
    <MudTextField @bind-Value="Category.Name" Label="Nombre" Required Immediate
                  Variant="Variant.Outlined" Class="mb-3" />
    <MudTextField @bind-Value="Category.Description" Label="Descripción" Lines="2"
                  Variant="Variant.Outlined" Class="mb-2" />
</MudForm>

<div class="d-flex justify-end gap-2 mt-4">
    <MudButton OnClick="Cancel" Variant="Variant.Text">Cancelar</MudButton>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save" OnClick="Submit">
        Guardar
    </MudButton>
</div>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public Category Category { get; set; } = new();

    private void Submit()
    {
        if (string.IsNullOrWhiteSpace(Category.Name))
        {
            return;
        }
        MudDialog.Close(DialogResult.Ok(true));
    }

    private void Cancel() => MudDialog.Cancel();
}

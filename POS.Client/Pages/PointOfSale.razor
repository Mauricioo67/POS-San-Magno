@page "/sales"
@inject SaleApiService SaleApi
@inject ProductApiService ProductApi
@inject CategoryApiService CategoryApi
@inject AuthStateService AuthState
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject StockAlertService StockAlerts

<PageTitle>Punto de venta - App POS</PageTitle>

<PageHeader Title="Punto de venta"
            Eyebrow="Caja"
            Description="Busca productos, arma el carrito y cobra en efectivo, tarjeta o transferencia."
            Icon="@Icons.Material.Filled.PointOfSale">
    <Actions>
        <MudButton Variant="Variant.Outlined" Color="Color.Inherit" Class="pos-btn-ghost"
                   StartIcon="@Icons.Material.Filled.ReceiptLong" Href="/sales/history">Historial</MudButton>
    </Actions>
</PageHeader>

@if (!AuthState.IsAuthenticated)
{
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">Debe iniciar sesión para usar el punto de venta.</MudAlert>
}
else if (_error != null)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@_error</MudAlert>
}
else
{
    <MudGrid Spacing="3">
        <MudItem xs="12" lg="7">
            <MudPaper Class="pos-card pos-card-pad mb-3" Elevation="0">
                <div class="pos-section-head">
                    <div>
                        <MudText Typo="Typo.overline" Class="pos-kicker">Catálogo</MudText>
                        <MudText Typo="Typo.h6" Class="pos-section-title">Productos disponibles</MudText>
                    </div>
                    <span class="pos-pill">@FilteredProducts.Count() producto(s)</span>
                </div>

                <div class="pos-toolbar" style="margin-bottom: 14px;">
                    <div class="pos-toolbar-filters">
                        <MudTextField @bind-Value="_productSearch" Placeholder="Buscar producto (nombre o código)"
                                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                                      Immediate="true" Class="pos-search" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        <MudSelect @bind-Value="_categoryFilter" Label="Categoría" Variant="Variant.Outlined"
                                   Margin="Margin.Dense" Style="min-width: 190px;">
                            <MudSelectItem Value="0">Todas</MudSelectItem>
                            @foreach (var category in _categories)
                            {
                                <MudSelectItem Value="@category.Id">@category.Name</MudSelectItem>
                            }
                        </MudSelect>
                    </div>
                </div>

                @if (!FilteredProducts.Any())
                {
                    <EmptyState Title="Sin productos disponibles"
                                Text="Revisa la búsqueda o el stock del catálogo."
                                Icon="@Icons.Material.Filled.SearchOff" />
                }
                else
                {
                    <div class="pos-product-grid">
                        @foreach (var product in FilteredProducts)
                        {
                            var disabled = product.CurrentStock <= 0 || CartContains(product.Id);
                            <button type="button" class="pos-product-card" disabled="@disabled"
                                    @onclick="() => AddToCart(product)">
                                <div class="d-flex align-center justify-space-between">
                                    <div class="pos-product-thumb">@Initial(product.Name)</div>
                                    <span class="pos-pill">@product.Code</span>
                                </div>
                                <div class="pos-product-name">@product.Name</div>
                                <div class="pos-product-price">@product.Price.ToString("C")</div>
                                <div class="d-flex align-center justify-space-between mt-auto">
                                    <span class="pos-product-stock @(product.CurrentStock <= product.StockMinimun ? "is-low" : "")">
                                        Stock: @product.CurrentStock
                                    </span>
                                    <MudIcon Icon="@(CartContains(product.Id) ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.AddShoppingCart)"
                                             Size="Size.Small" Color="@(CartContains(product.Id) ? Color.Success : Color.Primary)" />
                                </div>
                            </button>
                        }
                    </div>
                }
            </MudPaper>
        </MudItem>

        <MudItem xs="12" lg="5">
            <MudPaper Class="pos-card pos-card-pad mb-3" Elevation="0">
                <div class="pos-section-head">
                    <div>
                        <MudText Typo="Typo.overline" Class="pos-kicker">Cobro</MudText>
                        <MudText Typo="Typo.h6" Class="pos-section-title">Carrito de venta</MudText>
                    </div>
                    @if (_cart.Count > 0)
                    {
                        <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.DeleteSweep" OnClick="ClearCart">Vaciar</MudButton>
                    }
                </div>

                @if (_cart.Count == 0)
                {
                    <EmptyState Title="Carrito vacío"
                                Text="Agrega productos desde el catálogo para comenzar la venta."
                                Icon="@Icons.Material.Filled.ShoppingCart" />
                }
                else
                {
                    <div class="d-flex flex-column gap-2 mb-3">
                        @foreach (var item in _cart)
                        {
                            <div class="pos-cart-item">
                                <div class="flex-grow-1" style="min-width: 0;">
                                    <MudText Typo="Typo.body2" Class="pos-bold">@item.ProductName</MudText>
                                    <MudText Typo="Typo.caption" Class="pos-cell-muted">@item.UnitPrice.ToString("C") c/u</MudText>
                                </div>
                                <MudNumericField @bind-Value="item.Quantity" @bind-Value:after="Recalculate"
                                                 Min="1" Max="@item.MaxStock" Variant="Variant.Outlined"
                                                 Margin="Margin.Dense" Style="max-width: 96px;" Immediate="false" />
                                <MudText Typo="Typo.body2" Class="pos-money" Style="min-width: 80px; text-align: right;">
                                    @((item.UnitPrice * item.Quantity).ToString("C"))
                                </MudText>
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                               aria-label="Quitar producto" OnClick="() => RemoveFromCart(item.ProductId)" />
                            </div>
                        }
                    </div>

                    <div class="pos-total-box mb-3">
                        <div>
                            <MudText Typo="Typo.caption" Class="pos-cell-muted">Total a pagar</MudText>
                            <MudText Typo="Typo.h4" Class="pos-section-title" Style="line-height:1;">@_total.ToString("C")</MudText>
                        </div>
                        <MudIcon Icon="@Icons.Material.Filled.ShoppingBag" Color="Color.Primary" Size="Size.Large" />
                    </div>

                    <MudSelect @bind-Value="_paymentMethod" @bind-Value:after="OnPaymentMethodChanged"
                               Label="Método de pago" Variant="Variant.Outlined" Class="mb-3">
                        <MudSelectItem Value="@PaymentMethod.Efectivo">Efectivo</MudSelectItem>
                        <MudSelectItem Value="@PaymentMethod.Tarjeta">Tarjeta</MudSelectItem>
                        <MudSelectItem Value="@PaymentMethod.Transferencia">Transferencia</MudSelectItem>
                    </MudSelect>

                    @if (_paymentMethod == PaymentMethod.Efectivo)
                    {
                        <MudNumericField @bind-Value="_cashReceived" Label="Efectivo recibido" Min="0m"
                                         Format="C2" Variant="Variant.Outlined" Class="mb-2" Immediate="true" />
                        <div class="pos-chip-row mb-3">
                            <MudChip T="string" Size="Size.Small" Color="Color.Default" OnClick="SetExactCash">Exacto</MudChip>
                            @foreach (var amount in QuickCash)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Default"
                                         OnClick="@(() => _cashReceived = amount)">@amount.ToString("C0")</MudChip>
                            }
                        </div>
                        <div class="d-flex align-center justify-space-between mb-3">
                            <MudText Typo="Typo.body2" Class="pos-cell-muted">Vuelto</MudText>
                            <MudText Typo="Typo.h6" Class="pos-section-title">@ChangeAmount.ToString("C")</MudText>
                        </div>
                    }

                    <MudButton Variant="Variant.Filled" Color="Color.Success" FullWidth Size="Size.Large"
                               StartIcon="@Icons.Material.Filled.PointOfSale"
                               Disabled="@(_cart.Count == 0 || _processing || (_paymentMethod == PaymentMethod.Efectivo && _cashReceived < _total))"
                               OnClick="CheckoutAsync">
                        @(_processing ? "Procesando..." : "Registrar venta")
                    </MudButton>
                }
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudPaper Class="pos-card pos-table-card" Elevation="0">
        <div class="pos-card-pad pb-0">
            <div class="pos-section-head">
                <div>
                    <MudText Typo="Typo.overline" Class="pos-kicker">Reciente</MudText>
                    <MudText Typo="Typo.h6" Class="pos-section-title">Últimas ventas</MudText>
                </div>
                <MudButton Variant="Variant.Text" Color="Color.Primary" EndIcon="@Icons.Material.Filled.ArrowForward"
                           Href="/sales/history">Ver todo</MudButton>
            </div>
        </div>
        @if (_sales.Count == 0)
        {
            <EmptyState Title="Sin ventas registradas"
                        Text="La primera venta del día aparecerá aquí."
                        Icon="@Icons.Material.Filled.ReceiptLong" />
        }
        else
        {
            <MudTable Items="@_sales.Take(5)" Hover Dense>
                <HeaderContent>
                    <MudTh>#</MudTh>
                    <MudTh>Fecha</MudTh>
                    <MudTh>Vendedor</MudTh>
                    <MudTh>Método de pago</MudTh>
                    <MudTh Style="text-align: right">Total</MudTh>
                    <MudTh Style="text-align: right">Items</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd><span class="pos-cell-primary">@context.Id</span></MudTd>
                    <MudTd>@context.SaleDate.ToString("dd/MM/yyyy HH:mm")</MudTd>
                    <MudTd Class="pos-cell-muted">@context.User?.Name</MudTd>
                    <MudTd><MudChip T="string" Size="Size.Small" Color="@PaymentColor(context.PaymentMethod)">@context.PaymentMethod</MudChip></MudTd>
                    <MudTd Style="text-align: right" Class="pos-money">@context.TotalAmount.ToString("C")</MudTd>
                    <MudTd Style="text-align: right">@(context.SaleDetails?.Sum(d => d.Quantity) ?? 0)</MudTd>
                </RowTemplate>
            </MudTable>
        }
    </MudPaper>
}

@code {
    private string _productSearch = string.Empty;
    private int _categoryFilter;
    private string? _error;
    private bool _processing = false;
    private decimal _total;
    private decimal _cashReceived;
    private PaymentMethod _paymentMethod = PaymentMethod.Efectivo;
    private List<Product> _products = new();
    private List<Category> _categories = new();
    private List<Sale> _sales = new();
    private List<CartItem> _cart = new();

    private static readonly decimal[] QuickCash = { 10m, 20m, 50m, 100m };

    private class CartItem
    {
        public int ProductId { get; set; }
        public string ProductName { get; set; } = string.Empty;
        public decimal UnitPrice { get; set; }
        public int Quantity { get; set; } = 1;
        public int MaxStock { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        await AuthState.InitializeAsync();
        if (!AuthState.IsAuthenticated)
        {
            return;
        }
        await LoadAsync();
    }

    private IEnumerable<Product> FilteredProducts =>
        _products
            .Where(p => string.IsNullOrWhiteSpace(_productSearch)
                        || p.Name.Contains(_productSearch, StringComparison.OrdinalIgnoreCase)
                        || p.Code.Contains(_productSearch, StringComparison.OrdinalIgnoreCase))
            .Where(p => _categoryFilter == 0 || p.CategoryId == _categoryFilter)
            .OrderBy(p => p.Name);

    private bool CartContains(int productId) => _cart.Any(c => c.ProductId == productId);

    private decimal ChangeAmount => Math.Max(0, _cashReceived - _total);

    private static string Initial(string name) =>
        string.IsNullOrWhiteSpace(name) ? "?" : name.Trim()[0].ToString().ToUpperInvariant();

    private static Color PaymentColor(PaymentMethod method) => method switch
    {
        PaymentMethod.Efectivo => Color.Success,
        PaymentMethod.Tarjeta => Color.Info,
        _ => Color.Secondary
    };

    private void OnPaymentMethodChanged()
    {
        if (_paymentMethod == PaymentMethod.Efectivo)
        {
            _cashReceived = _total;
        }
    }

    private void SetExactCash() => _cashReceived = _total;

    private void AddToCart(Product product)
    {
        if (product.CurrentStock <= 0 || CartContains(product.Id))
        {
            return;
        }
        _cart.Add(new CartItem
        {
            ProductId = product.Id,
            ProductName = product.Name,
            UnitPrice = product.Price,
            MaxStock = product.CurrentStock
        });
        Recalculate();
        StateHasChanged();
    }

    private void RemoveFromCart(int productId)
    {
        _cart.RemoveAll(c => c.ProductId == productId);
        Recalculate();
        StateHasChanged();
    }

    private void ClearCart()
    {
        _cart.Clear();
        Recalculate();
        StateHasChanged();
    }

    private void Recalculate()
    {
        _total = _cart.Sum(c => c.UnitPrice * c.Quantity);
        if (_cart.Count == 0)
        {
            _cashReceived = 0;
        }
        else if (_paymentMethod == PaymentMethod.Efectivo && _cashReceived == 0)
        {
            _cashReceived = _total;
        }
    }

    private async Task LoadAsync()
    {
        _error = null;
        try
        {
            _products = await ProductApi.GetAllAsync(onlyActive: true);
            _categories = await CategoryApi.GetAllAsync();
            _sales = await SaleApi.GetAllAsync();
            _total = 0;
        }
        catch (Exception ex)
        {
            _error = $"No se pudieron cargar los productos y ventas: {ex.Message}";
        }
        StateHasChanged();
    }

    private async Task CheckoutAsync()
    {
        _processing = true;
        try
        {
            var request = new SaleRequest
            {
                UserId = AuthState.UserId,
                PaymentMethod = _paymentMethod,
                Items = _cart.Select(c => new SaleItemDto { ProductId = c.ProductId, Quantity = c.Quantity }).ToList()
            };
            var (success, sale, error) = await SaleApi.CreateAsync(request);
            if (success && sale != null)
            {
                var lines = _cart.Select(c => new SaleReceiptDialog.ReceiptLine
                {
                    Name = c.ProductName,
                    Quantity = c.Quantity,
                    UnitPrice = c.UnitPrice
                }).ToList();
                var isCash = _paymentMethod == PaymentMethod.Efectivo;
                var received = _cashReceived;

                Snackbar.Add($"Venta #{sale.Id} registrada por {sale.TotalAmount:C}", Severity.Success);
                _cart.Clear();
                Recalculate();
                await LoadAsync();
                await StockAlerts.RefreshAsync();
                await ShowReceiptAsync(sale, lines, isCash, received);
            }
            else
            {
                Snackbar.Add(error ?? "Error al registrar la venta", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al registrar la venta: {ex.Message}", Severity.Error);
        }
        finally
        {
            _processing = false;
        }
        StateHasChanged();
    }

    private async Task ShowReceiptAsync(Sale sale, List<SaleReceiptDialog.ReceiptLine> lines, bool isCash, decimal cashReceived)
    {
        var parameters = new DialogParameters
        {
            ["Sale"] = sale,
            ["Lines"] = lines,
            ["IsCash"] = isCash,
            ["CashReceived"] = cashReceived
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };
        await DialogService.ShowAsync<SaleReceiptDialog>("Venta registrada", parameters, options);
    }
}

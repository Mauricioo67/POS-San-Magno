@page "/sales"
@inject SaleApiService SaleApi
@inject ProductApiService ProductApi
@inject AuthStateService AuthState
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Punto de venta - App POS</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Punto de venta</MudText>

@if (!AuthState.IsAuthenticated)
{
    <MudAlert Severity="Severity.Warning">Debe iniciar sesión para usar el punto de venta.</MudAlert>
}
else if (_error != null)
{
    <MudAlert Severity="Severity.Error">@_error</MudAlert>
}
else
{
    <MudGrid>
        <MudItem xs="12" md="7">
            <MudPaper Class="pa-4 mb-4" Elevation="2">
                <MudText Typo="Typo.h6" Class="mb-2">Productos</MudText>
                <MudTextField @bind-Value="_productSearch" Placeholder="Buscar producto (nombre o código)"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Class="mb-2" Immediate="true" />
                <MudTable Items="@FilteredProducts" Hover Dense Height="280px">
                    <HeaderContent>
                        <MudTh>Código</MudTh>
                        <MudTh>Nombre</MudTh>
                        <MudTh Style="text-align: right">Precio</MudTh>
                        <MudTh Style="text-align: right">Stock</MudTh>
                        <MudTh></MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.Code</MudTd>
                        <MudTd>@context.Name</MudTd>
                        <MudTd Style="text-align: right">@context.Price.ToString("C")</MudTd>
                        <MudTd Style="text-align: right">@context.CurrentStock</MudTd>
                        <MudTd>
                            <MudIconButton Icon="@Icons.Material.Filled.AddShoppingCart" Size="Size.Small"
                                           Color="Color.Primary" Disabled="@(context.CurrentStock <= 0 || CartContains(context.Id))"
                                           OnClick="() => AddToCart(context)" />
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="5">
            <MudPaper Class="pa-4 mb-4" Elevation="2">
                <MudText Typo="Typo.h6" Class="mb-2">Carrito</MudText>
                @if (_cart.Count == 0)
                {
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">No hay productos en el carrito.</MudText>
                }
                else
                {
                    @foreach (var item in _cart)
                    {
                        <MudPaper Class="pa-2 mb-2 d-flex align-center" Elevation="1">
                            <div class="flex-grow-1">
                                <MudText Typo="Typo.body2" Class="pos-bold">@item.ProductName</MudText>
                                <MudText Typo="Typo.caption">@item.UnitPrice.ToString("C") c/u</MudText>
                            </div>
                            <MudNumericField @bind-Value="item.Quantity" @bind-Value:after="Recalculate" Min="1" Max="@item.MaxStock" Variant="Variant.Outlined"
                                             Style="max-width: 110px;" Immediate="false" />
                            <MudText Typo="Typo.body2" Class="ml-3">@((item.UnitPrice * item.Quantity).ToString("C"))</MudText>
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                           OnClick="() => RemoveFromCart(item.ProductId)" />
                        </MudPaper>
                    }
                }
                <MudDivider Class="my-3" />
                <MudText Typo="Typo.h6">Total: @_total.ToString("C")</MudText>
                <MudSelect @bind-Value="_paymentMethod" @bind-Value:after="OnPaymentMethodChanged"
                           Label="Método de pago" Class="mt-3 mb-3">
                    <MudSelectItem Value="@Shared.Enums.PaymentMethod.Efectivo">Efectivo</MudSelectItem>
                    <MudSelectItem Value="@Shared.Enums.PaymentMethod.Tarjeta">Tarjeta</MudSelectItem>
                    <MudSelectItem Value="@Shared.Enums.PaymentMethod.Transferencia">Transferencia</MudSelectItem>
                </MudSelect>
                @if (_paymentMethod == Shared.Enums.PaymentMethod.Efectivo)
                {
                    <MudNumericField @bind-Value="_cashReceived" Label="Efectivo recibido" Min="0m"
                                     Format="C2" Class="mb-2" Immediate="true" />
                    <MudText Typo="Typo.body1" Class="mb-3">
                        Vuelto: <strong>@ChangeAmount.ToString("C")</strong>
                    </MudText>
                }
                <MudButton Variant="Variant.Filled" Color="Color.Success" FullWidth StartIcon="@Icons.Material.Filled.PointOfSale"
                           Disabled="@(_cart.Count == 0 || _processing || (_paymentMethod == Shared.Enums.PaymentMethod.Efectivo && _cashReceived < _total))"
                           OnClick="CheckoutAsync">
                    @(_processing ? "Procesando..." : "Registrar venta")
                </MudButton>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudPaper Class="pa-4" Elevation="2">
        <MudText Typo="Typo.h6" Class="mb-2">Historial de ventas</MudText>
        <MudTable Items="@_sales" Hover Dense Striped>
            <HeaderContent>
                <MudTh>#</MudTh>
                <MudTh>Fecha</MudTh>
                <MudTh>Vendedor</MudTh>
                <MudTh>Método de pago</MudTh>
                <MudTh Style="text-align: right">Total</MudTh>
                <MudTh Style="text-align: right">Items</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.Id</MudTd>
                <MudTd>@context.SaleDate.ToString("dd/MM/yyyy HH:mm")</MudTd>
                <MudTd>@context.User?.Name</MudTd>
                <MudTd>@context.PaymentMethod</MudTd>
                <MudTd Style="text-align: right">@context.TotalAmount.ToString("C")</MudTd>
                <MudTd Style="text-align: right">@(context.SaleDetails?.Sum(d => d.Quantity) ?? 0)</MudTd>
            </RowTemplate>
        </MudTable>
    </MudPaper>
}

@code {
    private string _productSearch = string.Empty;
    private string? _error;
    private bool _processing = false;
    private decimal _total;
    private decimal _cashReceived;
    private Shared.Enums.PaymentMethod _paymentMethod = Shared.Enums.PaymentMethod.Efectivo;
    private List<Product> _products = new();
    private List<Sale> _sales = new();
    private List<CartItem> _cart = new();

    private class CartItem
    {
        public int ProductId { get; set; }
        public string ProductName { get; set; } = string.Empty;
        public decimal UnitPrice { get; set; }
        public int Quantity { get; set; } = 1;
        public int MaxStock { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        await AuthState.InitializeAsync();
        if (!AuthState.IsAuthenticated)
        {
            return;
        }
        await LoadAsync();
    }

    private IEnumerable<Product> FilteredProducts =>
        string.IsNullOrWhiteSpace(_productSearch)
            ? _products
            : _products.Where(p => p.Name.Contains(_productSearch, StringComparison.OrdinalIgnoreCase)
                                || p.Code.Contains(_productSearch, StringComparison.OrdinalIgnoreCase));

    private bool CartContains(int productId) => _cart.Any(c => c.ProductId == productId);

    private decimal ChangeAmount => Math.Max(0, _cashReceived - _total);

    private void OnPaymentMethodChanged()
    {
        if (_paymentMethod == Shared.Enums.PaymentMethod.Efectivo)
        {
            _cashReceived = _total;
        }
    }

    private void AddToCart(Product product)
    {
        _cart.Add(new CartItem
        {
            ProductId = product.Id,
            ProductName = product.Name,
            UnitPrice = product.Price,
            MaxStock = product.CurrentStock
        });
        Recalculate();
        StateHasChanged();
    }

    private void RemoveFromCart(int productId)
    {
        _cart.RemoveAll(c => c.ProductId == productId);
        Recalculate();
        StateHasChanged();
    }

    private void Recalculate()
    {
        _total = _cart.Sum(c => c.UnitPrice * c.Quantity);
        if (_cart.Count == 0)
        {
            _cashReceived = 0;
        }
        else if (_paymentMethod == Shared.Enums.PaymentMethod.Efectivo && _cashReceived == 0)
        {
            _cashReceived = _total;
        }
    }

    private async Task LoadAsync()
    {
        _error = null;
        try
        {
            _products = await ProductApi.GetAllAsync(onlyActive: true);
            _sales = await SaleApi.GetAllAsync();
            _total = 0;
        }
        catch (Exception ex)
        {
            _error = $"No se pudieron cargar los productos y ventas: {ex.Message}";
        }
        StateHasChanged();
    }

    private async Task CheckoutAsync()
    {
        _processing = true;
        try
        {
            var request = new SaleRequest
            {
                UserId = AuthState.UserId,
                PaymentMethod = _paymentMethod,
                Items = _cart.Select(c => new SaleItemDto { ProductId = c.ProductId, Quantity = c.Quantity }).ToList()
            };
            var (success, sale, error) = await SaleApi.CreateAsync(request);
            if (success && sale != null)
            {
                var lines = _cart.Select(c => new SaleReceiptDialog.ReceiptLine
                {
                    Name = c.ProductName,
                    Quantity = c.Quantity,
                    UnitPrice = c.UnitPrice
                }).ToList();
                var isCash = _paymentMethod == Shared.Enums.PaymentMethod.Efectivo;
                var received = _cashReceived;

                Snackbar.Add($"Venta #{sale.Id} registrada por {sale.TotalAmount:C}", Severity.Success);
                _cart.Clear();
                Recalculate();
                await LoadAsync();
                await ShowReceiptAsync(sale, lines, isCash, received);
            }
            else
            {
                Snackbar.Add(error ?? "Error al registrar la venta", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al registrar la venta: {ex.Message}", Severity.Error);
        }
        finally
        {
            _processing = false;
        }
        StateHasChanged();
    }

    private async Task ShowReceiptAsync(Sale sale, List<SaleReceiptDialog.ReceiptLine> lines, bool isCash, decimal cashReceived)
    {
        var parameters = new DialogParameters
        {
            ["Sale"] = sale,
            ["Lines"] = lines,
            ["IsCash"] = isCash,
            ["CashReceived"] = cashReceived
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };
        await DialogService.ShowAsync<SaleReceiptDialog>("Venta registrada", parameters, options);
    }
}

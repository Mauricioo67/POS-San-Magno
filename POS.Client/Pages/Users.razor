@page "/users"
@inject UserApiService UserApi
@inject AuthStateService AuthState
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Usuarios - App POS</PageTitle>

<PageHeader Title="Usuarios"
            Eyebrow="Seguridad"
            Description="Administra cuentas, roles y estado de acceso del personal."
            Icon="@Icons.Material.Filled.VerifiedUser">
    <Actions>
        <MudButton Variant="Variant.Filled" Color="Color.Inherit" Class="pos-btn-light"
                   StartIcon="@Icons.Material.Filled.PersonAdd" OnClick="CreateAsync">Nuevo usuario</MudButton>
    </Actions>
</PageHeader>

@if (_loading)
{
    <MudProgressLinear Indeterminate Color="Color.Primary" />
}
else if (!AuthState.IsAuthenticated)
{
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">Debe iniciar sesión para ver esta sección.</MudAlert>
}
else if (!AuthState.IsAdmin)
{
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">Solo los administradores pueden ver los usuarios.</MudAlert>
}
else if (_error != null)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@_error</MudAlert>
}
else
{
    <MudGrid Spacing="3" Class="mb-4">
        <MudItem xs="12" sm="6" md="3">
            <StatCard Label="Cuentas" Value="@_users.Count.ToString()" Hint="Usuarios registrados"
                      Icon="@Icons.Material.Filled.Group" Accent="linear-gradient(135deg,#4f46e5,#7c3aed)" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <StatCard Label="Activas" Value="@_users.Count(u => u.IsActive).ToString()" Hint="Con acceso al sistema"
                      Icon="@Icons.Material.Filled.CheckCircle" Accent="linear-gradient(135deg,#10b981,#06b6d4)" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <StatCard Label="Administradores" Value="@_users.Count(u => u.Role == "Administrador").ToString()"
                      Hint="Control total" Icon="@Icons.Material.Filled.AdminPanelSettings"
                      Accent="linear-gradient(135deg,#ec4899,#f59e0b)" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <StatCard Label="Cajeros" Value="@_users.Count(u => u.Role == "Cajero").ToString()"
                      Hint="Operación de caja" Icon="@Icons.Material.Filled.PointOfSale"
                      Accent="linear-gradient(135deg,#06b6d4,#0ea5e9)" />
        </MudItem>
    </MudGrid>

    <MudPaper Class="pos-card pos-table-card" Elevation="0">
        @if (_users.Count == 0)
        {
            <EmptyState Title="Sin usuarios"
                        Text="Crea la primera cuenta para habilitar el acceso al sistema."
                        Icon="@Icons.Material.Filled.PersonAdd" />
        }
        else
        {
            <MudTable Items="@_users" Hover Dense Striped Breakpoint="Breakpoint.Sm">
                <HeaderContent>
                    <MudTh>Id</MudTh>
                    <MudTh>Usuario</MudTh>
                    <MudTh>Email</MudTh>
                    <MudTh>Rol</MudTh>
                    <MudTh>Estado</MudTh>
                    <MudTh Style="text-align: right">Acciones</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd><span class="pos-cell-muted">#@context.Id</span></MudTd>
                    <MudTd>
                        <div class="d-flex align-center gap-2">
                            <div class="pos-shortcut-icon" style="width:36px;height:36px;border-radius:11px;background:linear-gradient(135deg,#4f46e5,#7c3aed);">
                                <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" />
                            </div>
                            <span class="pos-cell-primary">@context.Name</span>
                        </div>
                    </MudTd>
                    <MudTd Class="pos-cell-muted">@context.Email</MudTd>
                    <MudTd>
                        <MudChip T="string" Size="Size.Small"
                                 Color="@(context.Role == "Administrador" ? Color.Primary : Color.Default)">
                            @context.Role
                        </MudChip>
                    </MudTd>
                    <MudTd>
                        <MudChip T="string" Size="Size.Small"
                                 Color="@(context.IsActive ? Color.Success : Color.Error)">
                            @(context.IsActive ? "Activo" : "Inactivo")
                        </MudChip>
                    </MudTd>
                    <MudTd Style="text-align: right">
                        <div class="d-flex justify-end">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small"
                                           aria-label="Editar usuario" OnClick="() => EditAsync(context)" />
                            @if (context.IsActive)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.PersonOff" Color="Color.Error" Size="Size.Small"
                                               aria-label="Desactivar usuario" OnClick="() => DeactivateAsync(context)" />
                            }
                        </div>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
        <div class="px-4 pb-3">
            <MudText Typo="Typo.caption" Class="pos-cell-muted">
                Las cuentas desactivadas se conservan para proteger el historial de operaciones.
            </MudText>
        </div>
    </MudPaper>
}

@code {
    private bool _loading = true;
    private string? _error;
    private List<UserDto> _users = new();

    protected override async Task OnInitializedAsync()
    {
        await AuthState.InitializeAsync();
        if (AuthState.IsAdmin)
        {
            await LoadAsync();
        }
        _loading = false;
    }

    private async Task LoadAsync()
    {
        _error = null;
        try
        {
            _users = await UserApi.GetAllAsync();
        }
        catch (Exception ex)
        {
            _error = $"No se pudieron cargar los usuarios: {ex.Message}";
        }
    }

    private async Task CreateAsync()
    {
        var request = new UserManagementRequest { Role = Role.Cajero, IsActive = true };
        if (!await ShowDialogAsync(request, true))
        {
            return;
        }

        var (success, error) = await UserApi.CreateAsync(request);
        if (!success)
        {
            Snackbar.Add(error ?? "No se pudo crear el usuario", Severity.Error);
            return;
        }

        Snackbar.Add("Usuario creado", Severity.Success);
        await LoadAsync();
    }

    private async Task EditAsync(UserDto user)
    {
        Enum.TryParse(user.Role, out Role role);
        var request = new UserManagementRequest
        {
            Name = user.Name,
            Email = user.Email,
            Role = role,
            IsActive = user.IsActive
        };
        if (!await ShowDialogAsync(request, false))
        {
            return;
        }

        var (success, error) = await UserApi.UpdateAsync(user, request);
        if (!success)
        {
            Snackbar.Add(error ?? "No se pudo actualizar el usuario", Severity.Error);
            return;
        }

        Snackbar.Add("Usuario actualizado", Severity.Success);
        await LoadAsync();
    }

    private async Task DeactivateAsync(UserDto user)
    {
        var parameters = new DialogParameters { ["Message"] = $"¿Desactivar la cuenta de {user.Name}?" };
        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Confirmar", parameters);
        if ((await dialog.Result) is not { Canceled: false, Data: not null })
        {
            return;
        }

        var (success, error) = await UserApi.DeactivateAsync(user.Id);
        if (!success)
        {
            Snackbar.Add(error ?? "No se pudo desactivar el usuario", Severity.Error);
            return;
        }

        Snackbar.Add("Usuario desactivado", Severity.Success);
        await LoadAsync();
    }

    private async Task<bool> ShowDialogAsync(UserManagementRequest request, bool isNew)
    {
        var parameters = new DialogParameters
        {
            ["User"] = request,
            ["IsNew"] = isNew
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<UserDialog>(isNew ? "Nuevo usuario" : "Editar usuario", parameters, options);
        return (await dialog.Result) is { Canceled: false, Data: not null };
    }
}

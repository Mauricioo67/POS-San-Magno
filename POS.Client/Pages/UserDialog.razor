<div class="d-flex align-center gap-3 mb-4">
    <div class="pos-dialog-icon">
        <MudIcon Icon="@(IsNew ? Icons.Material.Filled.PersonAdd : Icons.Material.Filled.ManageAccounts)" />
    </div>
    <div>
        <MudText Typo="Typo.overline" Class="pos-kicker">Seguridad</MudText>
        <MudText Typo="Typo.h6" Class="pos-dialog-title">@(IsNew ? "Nuevo usuario" : "Editar usuario")</MudText>
    </div>
</div>

<MudForm>
    <MudGrid Spacing="2">
        <MudItem xs="12">
            <MudTextField @bind-Value="User.Name" Label="Nombre completo" Required Immediate
                          Variant="Variant.Outlined" Class="mb-2" />
        </MudItem>
        <MudItem xs="12">
            <MudTextField @bind-Value="User.Email" Label="Email" Required Immediate
                          Variant="Variant.Outlined" InputType="InputType.Email" Class="mb-2" />
        </MudItem>
        <MudItem xs="12" sm="6">
            <MudSelect @bind-Value="User.Role" Label="Rol" Variant="Variant.Outlined" Class="mb-2">
                <MudSelectItem Value="@Role.Cajero">Cajero</MudSelectItem>
                <MudSelectItem Value="@Role.Administrador">Administrador</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6">
            <MudSwitch @bind-Value="User.IsActive" Label="Cuenta activa" Color="Color.Primary" Class="mb-2 mt-2" />
        </MudItem>
        <MudItem xs="12">
            <MudTextField @bind-Value="User.Password" Label="@(IsNew ? "Contraseña" : "Nueva contraseña (opcional)")"
                          InputType="InputType.Password" Required="IsNew" Variant="Variant.Outlined" Class="mb-2" />
        </MudItem>
    </MudGrid>
</MudForm>

<div class="d-flex justify-end gap-2 mt-4">
    <MudButton OnClick="Cancel" Variant="Variant.Text">Cancelar</MudButton>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save" OnClick="Submit">
        Guardar
    </MudButton>
</div>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public UserManagementRequest User { get; set; } = new();

    [Parameter]
    public bool IsNew { get; set; }

    private void Submit()
    {
        if (string.IsNullOrWhiteSpace(User.Name)
            || string.IsNullOrWhiteSpace(User.Email)
            || !User.Email.Contains('@')
            || (IsNew && User.Password.Length < 6)
            || (!string.IsNullOrEmpty(User.Password) && User.Password.Length < 6))
        {
            return;
        }

        MudDialog.Close(DialogResult.Ok(true));
    }

    private void Cancel() => MudDialog.Cancel();
}

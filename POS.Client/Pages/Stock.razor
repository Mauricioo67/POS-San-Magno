@page "/stock"
@inject StockApiService StockApi
@inject ProductApiService ProductApi
@inject AuthStateService AuthState
@inject ISnackbar Snackbar

<PageTitle>Stock - App POS</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Movimientos de stock</MudText>

@if (!AuthState.IsAuthenticated)
{
    <MudAlert Severity="Severity.Warning">Debe iniciar sesión para ver esta sección.</MudAlert>
}
else if (_error != null)
{
    <MudAlert Severity="Severity.Error">@_error</MudAlert>
}
else
{
    <MudPaper Class="pa-4 mb-4" Elevation="2">
        <MudText Typo="Typo.h6" Class="mb-2">Registrar movimiento</MudText>
        <MudGrid Spacing="2">
            <MudItem xs="12" md="3">
                <MudSelect @bind-Value="_productId" Label="Producto">
                    @foreach (var product in _products)
                    {
                        <MudSelectItem Value="@product.Id">@product.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="2">
                <MudSelect @bind-Value="_movementType" Label="Tipo">
                    <MudSelectItem Value="@Shared.Enums.MovementType.Entrada">Entrada</MudSelectItem>
                    <MudSelectItem Value="@Shared.Enums.MovementType.Salida">Salida</MudSelectItem>
                    @if (AuthState.IsAdmin)
                    {
                        <MudSelectItem Value="@Shared.Enums.MovementType.Ajuste">Ajuste</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="2">
                <MudNumericField @bind-Value="_quantity" Label="Cantidad" Min="1" />
            </MudItem>
            <MudItem xs="12" md="3">
                <MudTextField @bind-Value="_notes" Label="Notas" MaxLines="1" />
            </MudItem>
            <MudItem xs="12" md="2">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth StartIcon="@Icons.Material.Filled.Save"
                           Disabled="@(_productId <= 0 || _saving)" OnClick="RegisterMovementAsync">Registrar</MudButton>
            </MudItem>
        </MudGrid>
        @if (_movementType == Shared.Enums.MovementType.Ajuste)
        {
            <MudText Typo="Typo.caption" Class="mud-warning-text mt-1">
                El ajuste fija el stock actual del producto en la cantidad indicada (solo administradores).
            </MudText>
        }
    </MudPaper>

    <MudTable Items="@FilteredMovements" Hover Striped Dense>
        <HeaderContent>
            <MudTh>Fecha</MudTh>
            <MudTh>Producto</MudTh>
            <MudTh>Tipo</MudTh>
            <MudTh Style="text-align: right">Cantidad</MudTh>
            <MudTh>Usuario</MudTh>
            <MudTh>Notas</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.MovementDate.ToString("dd/MM/yyyy HH:mm")</MudTd>
            <MudTd>@context.Product?.Name</MudTd>
            <MudTd>
                <MudChip T="string" Color="@ChipColorFor(context.MovementType)" Size="Size.Small">@context.MovementType</MudChip>
            </MudTd>
            <MudTd Style="text-align: right">@context.Quantity</MudTd>
            <MudTd>@context.User?.Name</MudTd>
            <MudTd>@context.Notes</MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    [SupplyParameterFromQuery(Name = "productId")]
    public int? ProductIdQuery { get; set; }

    private bool _saving = false;
    private string? _error;
    private int _productId;
    private Shared.Enums.MovementType _movementType = Shared.Enums.MovementType.Entrada;
    private int _quantity = 1;
    private string _notes = string.Empty;
    private List<POS.Shared.Entities.Product> _products = new();
    private List<POS.Shared.Entities.Stock> _movements = new();

    protected override async Task OnInitializedAsync()
    {
        await AuthState.InitializeAsync();
        if (!AuthState.IsAuthenticated)
        {
            return;
        }
        try
        {
            _products = await ProductApi.GetAllAsync();
            if (ProductIdQuery.HasValue && _products.Any(p => p.Id == ProductIdQuery.Value))
            {
                _productId = ProductIdQuery.Value;
            }
            await LoadMovementsAsync();
        }
        catch (Exception ex)
        {
            _error = $"No se pudieron cargar los movimientos de stock: {ex.Message}";
        }
    }

    private IEnumerable<POS.Shared.Entities.Stock> FilteredMovements =>
        _productId <= 0 ? _movements : _movements.Where(m => m.ProductId == _productId);

    private static Color ChipColorFor(Shared.Enums.MovementType type) => type switch
    {
        Shared.Enums.MovementType.Entrada => Color.Success,
        Shared.Enums.MovementType.Salida => Color.Error,
        _ => Color.Warning
    };

    private async Task LoadMovementsAsync()
    {
        _movements = await StockApi.GetAllAsync();
    }

    private async Task RegisterMovementAsync()
    {
        _saving = true;
        try
        {
            var request = new StockMovementRequest
            {
                ProductId = _productId,
                MovementType = _movementType,
                Quantity = _quantity,
                UserId = AuthState.UserId,
                Notes = _notes
            };
            var (success, error) = await StockApi.CreateAsync(request);
            if (success)
            {
                Snackbar.Add("Movimiento registrado", Severity.Success);
                _notes = string.Empty;
                _products = await ProductApi.GetAllAsync();
                await LoadMovementsAsync();
            }
            else
            {
                Snackbar.Add(error ?? "Error al registrar el movimiento", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al registrar el movimiento: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
        StateHasChanged();
    }
}

@page "/about"

<PageTitle>Acerca de - App POS</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Acerca de App POS</MudText>

<MudPaper Class="pa-4 mb-4" Elevation="2">
    <MudText Typo="Typo.h6" Class="mb-2">Sistema de punto de venta San Magno</MudText>
    <MudText Typo="Typo.body1" Class="mb-2">
        Aplicación web para registrar ventas, controlar stock, administrar el catálogo de productos y
        realizar el cierre de caja.
    </MudText>
    <MudText Typo="Typo.body2" Class="mud-text-secondary">
        Frontend Blazor WebAssembly con MudBlazor · Backend ASP.NET Core Web API con EF Core y SQL Server ·
        Autenticación JWT con roles Administrador y Cajero.
    </MudText>
</MudPaper>

<MudPaper Class="pa-4 mb-4" Elevation="2">
    <MudText Typo="Typo.h6" Class="mb-2">Módulos</MudText>
    <MudList T="string" Dense>
        <MudListItem T="string" Icon="@Icons.Material.Filled.PointOfSale">Punto de venta: carrito, método de pago e historial.</MudListItem>
        <MudListItem T="string" Icon="@Icons.Material.Filled.Inventory2">Productos y categorías con control de stock mínimo.</MudListItem>
        <MudListItem T="string" Icon="@Icons.Material.Filled.Inventory">Movimientos de stock: entradas, salidas y ajustes.</MudListItem>
        <MudListItem T="string" Icon="@Icons.Material.Filled.Summarize">Cierre de caja por método de pago (solo administradores).</MudListItem>
        <MudListItem T="string" Icon="@Icons.Material.Filled.Assessment">Reportes por período (solo administradores).</MudListItem>
        <MudListItem T="string" Icon="@Icons.Material.Filled.VerifiedUser">Usuarios y roles (solo administradores).</MudListItem>
    </MudList>
</MudPaper>

<MudPaper Class="pa-4" Elevation="2">
    <MudText Typo="Typo.h6" Class="mb-2">Servicios</MudText>
    <MudText Typo="Typo.body2">API: <code>https://localhost:7008</code></MudText>
    <MudText Typo="Typo.body2">Cliente: <code>https://localhost:7282</code></MudText>
</MudPaper>

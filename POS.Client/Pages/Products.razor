@page "/products"
@inject ProductApiService ProductApi
@inject CategoryApiService CategoryApi
@inject AuthStateService AuthState
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager Navigation

<PageTitle>Productos - App POS</PageTitle>

<PageHeader Title="Productos"
            Eyebrow="Catálogo"
            Description="Administra precios, categorías, existencias y alertas de stock mínimo."
            Icon="@Icons.Material.Filled.Inventory2">
    <Actions>
        @if (AuthState.IsAdmin)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Inherit" Class="pos-btn-light"
                       StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateDialog">Nuevo producto</MudButton>
        }
        <MudButton Variant="Variant.Outlined" Color="Color.Inherit" Class="pos-btn-ghost"
                   StartIcon="@Icons.Material.Filled.Inventory" OnClick="@(() => Navigation.NavigateTo("/stock"))">
            Movimientos
        </MudButton>
    </Actions>
</PageHeader>

@if (_loading)
{
    <MudProgressLinear Indeterminate Color="Color.Primary" />
}
else if (!AuthState.IsAuthenticated)
{
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">Debe iniciar sesión para ver esta sección.</MudAlert>
}
else if (_error != null)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@_error</MudAlert>
}
else
{
    <MudGrid Spacing="3" Class="mb-4">
        <MudItem xs="12" sm="6" md="3">
            <StatCard Label="Productos" Value="@_products.Count.ToString()" Hint="En el catálogo"
                      Icon="@Icons.Material.Filled.Category" Accent="linear-gradient(135deg,#4f46e5,#7c3aed)" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <StatCard Label="Activos" Value="@_products.Count(p => p.IsActive).ToString()" Hint="Disponibles para venta"
                      Icon="@Icons.Material.Filled.CheckCircle" Accent="linear-gradient(135deg,#10b981,#06b6d4)" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <StatCard Label="Stock bajo" Value="@LowStockCount.ToString()" Hint="Requieren reposición"
                      Icon="@Icons.Material.Filled.WarningAmber"
                      Accent="@(LowStockCount > 0 ? "linear-gradient(135deg,#ef4444,#f59e0b)" : "linear-gradient(135deg,#10b981,#84cc16)")" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <StatCard Label="Valor inventario" Value="@InventoryValue.ToString("C")" Hint="Precio × stock actual"
                      Icon="@Icons.Material.Filled.Savings" Accent="linear-gradient(135deg,#ec4899,#7c3aed)" />
        </MudItem>
    </MudGrid>

    <div class="pos-toolbar">
        <div class="pos-toolbar-filters">
            <MudTextField @bind-Value="_search" Placeholder="Buscar por código o nombre" Variant="Variant.Outlined"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                          Immediate="true" Class="pos-search" Margin="Margin.Dense" />
            <MudSelect @bind-Value="_categoryFilter" Variant="Variant.Outlined" Margin="Margin.Dense"
                       Label="Categoría" Style="min-width: 210px;">
                <MudSelectItem Value="0">Todas las categorías</MudSelectItem>
                @foreach (var category in _categories)
                {
                    <MudSelectItem Value="@category.Id">@category.Name</MudSelectItem>
                }
            </MudSelect>
        </div>
        <span class="pos-pill">
            <MudIcon Icon="@Icons.Material.Filled.FilterList" Size="Size.Small" />
            @FilteredProducts.Count() resultado(s)
        </span>
    </div>

    <MudPaper Class="pos-card pos-table-card" Elevation="0">
        @if (!FilteredProducts.Any())
        {
            <EmptyState Title="Sin productos"
                        Text="Ajusta los filtros o crea un nuevo producto para comenzar."
                        Icon="@Icons.Material.Filled.Inventory2" />
        }
        else
        {
            <MudTable Items="@FilteredProducts" Hover Dense Breakpoint="Breakpoint.Md">
                <HeaderContent>
                    <MudTh>Código</MudTh>
                    <MudTh>Producto</MudTh>
                    <MudTh>Categoría</MudTh>
                    <MudTh Style="text-align: right">Precio</MudTh>
                    <MudTh Style="text-align: right">Stock</MudTh>
                    <MudTh Style="text-align: right">Mínimo</MudTh>
                    <MudTh>Estado</MudTh>
                    <MudTh Style="text-align: right">Acciones</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd><span class="pos-mono pos-cell-muted">@context.Code</span></MudTd>
                    <MudTd>
                        <div class="pos-cell-primary">@context.Name</div>
                        <div class="pos-cell-muted">@context.Description</div>
                    </MudTd>
                    <MudTd><span class="pos-pill">@context.Category?.Name</span></MudTd>
                    <MudTd Style="text-align: right" Class="pos-money">@context.Price.ToString("C")</MudTd>
                    <MudTd Style="text-align: right">
                        <MudChip T="string" Size="Size.Small" Color="@StockColor(context)">@context.CurrentStock</MudChip>
                    </MudTd>
                    <MudTd Style="text-align: right">@context.StockMinimun</MudTd>
                    <MudTd>
                        <MudChip T="string" Size="Size.Small" Color="@(context.IsActive ? Color.Success : Color.Default)">
                            @(context.IsActive ? "Activo" : "Inactivo")
                        </MudChip>
                    </MudTd>
                    <MudTd Style="text-align: right">
                        <div class="d-flex justify-end">
                            @if (AuthState.IsAdmin)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary"
                                               aria-label="Editar producto" OnClick="() => OpenEditDialog(context)" />
                                @if (context.IsActive)
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                                   aria-label="Desactivar producto" OnClick="() => DeactivateAsync(context)" />
                                }
                            }
                            <MudIconButton Icon="@Icons.Material.Filled.Inventory" Size="Size.Small" Color="Color.Info"
                                           aria-label="Movimiento de stock" OnClick="() => GoToStock(context.Id)" />
                        </div>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
    </MudPaper>
}

@code {
    private bool _loading = true;
    private string? _error;
    private string _search = string.Empty;
    private int _categoryFilter;
    private List<Product> _products = new();
    private List<Category> _categories = new();

    private int LowStockCount => _products.Count(p => p.IsActive && p.CurrentStock <= p.StockMinimun);
    private decimal InventoryValue => _products.Sum(p => p.Price * p.CurrentStock);

    private IEnumerable<Product> FilteredProducts =>
        _products.Where(p => string.IsNullOrWhiteSpace(_search)
                             || p.Code.Contains(_search, StringComparison.OrdinalIgnoreCase)
                             || p.Name.Contains(_search, StringComparison.OrdinalIgnoreCase))
                 .Where(p => _categoryFilter == 0 || p.CategoryId == _categoryFilter)
                 .OrderBy(p => p.Name);

    protected override async Task OnInitializedAsync()
    {
        await AuthState.InitializeAsync();
        await LoadAsync();
    }

    private static Color StockColor(Product product) =>
        product.CurrentStock <= 0 ? Color.Error
        : product.CurrentStock <= product.StockMinimun ? Color.Warning
        : Color.Success;

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        if (!AuthState.IsAuthenticated)
        {
            _loading = false;
            return;
        }
        try
        {
            _products = await ProductApi.GetAllAsync();
            _categories = await CategoryApi.GetAllAsync();
        }
        catch (Exception ex)
        {
            _error = $"No se pudieron cargar los productos: {ex.Message}";
        }
        _loading = false;
    }

    private void GoToStock(int productId) => Navigation.NavigateTo($"/stock?productId={productId}");

    private async Task OpenCreateDialog()
    {
        if (_categories.Count == 0)
        {
            Snackbar.Add("Primero crea al menos una categoría en Categorías.", Severity.Warning);
            return;
        }
        var product = new Product { IsActive = true, CategoryId = _categories.First().Id };
        var result = await ShowDialog(product, "Nuevo producto");
        if (result)
        {
            var (success, error) = await ProductApi.CreateAsync(product);
            if (success)
            {
                Snackbar.Add("Producto creado", Severity.Success);
                await LoadAsync();
            }
            else
            {
                Snackbar.Add(error ?? "Error al crear", Severity.Error);
            }
        }
    }

    private async Task OpenEditDialog(Product existing)
    {
        var product = new Product
        {
            Id = existing.Id,
            Code = existing.Code,
            Name = existing.Name,
            Description = existing.Description,
            Price = existing.Price,
            CurrentStock = existing.CurrentStock,
            StockMinimun = existing.StockMinimun,
            CategoryId = existing.CategoryId,
            IsActive = existing.IsActive,
            ImageUrl = existing.ImageUrl
        };
        var result = await ShowDialog(product, "Editar producto");
        if (result)
        {
            var (success, error) = await ProductApi.UpdateAsync(product);
            if (success)
            {
                Snackbar.Add("Producto actualizado", Severity.Success);
                await LoadAsync();
            }
            else
            {
                Snackbar.Add(error ?? "Error al actualizar", Severity.Error);
            }
        }
    }

    private async Task<bool> ShowDialog(Product product, string title)
    {
        var parameters = new DialogParameters
        {
            ["Product"] = product,
            ["Categories"] = _categories,
            ["IsNew"] = product.Id == 0
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<ProductDialog>(title, parameters, options);
        var result = await dialog.Result;
        return result is { Canceled: false, Data: not null };
    }

    private async Task DeactivateAsync(Product product)
    {
        var parameters = new DialogParameters { ["Message"] = $"¿Desactivar el producto '{product.Name}'?" };
        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Confirmar", parameters);
        if ((await dialog.Result) is not { Canceled: false, Data: not null })
        {
            return;
        }

        var (success, error) = await ProductApi.DeleteAsync(product.Id);
        if (!success)
        {
            Snackbar.Add(error ?? "No se pudo desactivar el producto", Severity.Error);
            return;
        }

        Snackbar.Add("Producto desactivado", Severity.Success);
        await LoadAsync();
    }
}

@inject ISnackbar Snackbar
@inject IJSRuntime JS

<div class="d-flex align-center gap-3 mb-4">
    <div class="pos-dialog-icon" style="background: linear-gradient(135deg,#10b981,#06b6d4);">
        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" />
    </div>
    <div>
        <MudText Typo="Typo.overline" Class="pos-kicker">Venta registrada</MudText>
        <MudText Typo="Typo.h6" Class="pos-dialog-title">Venta #@Sale?.Id</MudText>
        <MudText Typo="Typo.caption" Class="pos-cell-muted">@Sale?.SaleDate.ToString("dd/MM/yyyy HH:mm")</MudText>
    </div>
</div>

<MudPaper Class="pos-card pos-table-card" Elevation="0">
    <MudSimpleTable Dense Hover>
        <thead>
            <tr>
                <th>Producto</th>
                <th Style="text-align: right">Cant.</th>
                <th Style="text-align: right">Precio</th>
                <th Style="text-align: right">Subtotal</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var line in Lines)
            {
                <tr>
                    <td class="pos-cell-primary">@line.Name</td>
                    <td Style="text-align: right">@line.Quantity</td>
                    <td Style="text-align: right">@line.UnitPrice.ToString("C")</td>
                    <td Style="text-align: right" class="pos-money">@line.Total.ToString("C")</td>
                </tr>
            }
        </tbody>
    </MudSimpleTable>
</MudPaper>

<div class="pos-total-box mt-3">
    <div>
        <MudText Typo="Typo.caption" Class="pos-cell-muted">Total pagado</MudText>
        <MudText Typo="Typo.h4" Class="pos-section-title" Style="line-height:1;">@Total.ToString("C")</MudText>
    </div>
    <MudChip T="string" Color="Color.Primary" Size="Size.Small">@Sale?.PaymentMethod</MudChip>
</div>

@if (IsCash)
{
    <div class="d-flex justify-space-between mt-3">
        <MudText Typo="Typo.body2" Class="pos-cell-muted">Efectivo recibido</MudText>
        <MudText Typo="Typo.body2" Class="pos-bold">@CashReceived.ToString("C")</MudText>
    </div>
    <div class="d-flex justify-space-between mt-1">
        <MudText Typo="Typo.body2" Class="pos-cell-muted">Vuelto</MudText>
        <MudText Typo="Typo.h6" Class="pos-section-title">@Change.ToString("C")</MudText>
    </div>
}

<div class="d-flex justify-end gap-2 mt-4">
    <MudButton OnClick="CopySummary" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ContentCopy">Copiar resumen</MudButton>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Close">Cerrar</MudButton>
</div>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public Sale? Sale { get; set; }

    [Parameter]
    public List<ReceiptLine> Lines { get; set; } = new();

    [Parameter]
    public bool IsCash { get; set; }

    [Parameter]
    public decimal CashReceived { get; set; }

    private decimal Total => Lines.Sum(l => l.Total);
    private decimal Change => Math.Max(0, CashReceived - Total);

    private void Close() => MudDialog.Close();

    private async Task CopySummary()
    {
        var summary = $"Venta #{Sale?.Id} - {Sale?.SaleDate:dd/MM/yyyy HH:mm}\n" +
                      string.Join("\n", Lines.Select(l => $"{l.Quantity} x {l.Name} = {l.Total:C}")) +
                      $"\nTotal: {Total:C}";
        var copied = await JS.InvokeAsync<bool>("posCopy", summary);
        Snackbar.Add(copied ? "Resumen copiado" : "No se pudo copiar el resumen",
            copied ? Severity.Success : Severity.Warning);
    }

    public class ReceiptLine
    {
        public string Name { get; set; } = string.Empty;
        public int Quantity { get; set; }
        public decimal UnitPrice { get; set; }
        public decimal Total => UnitPrice * Quantity;
    }
}

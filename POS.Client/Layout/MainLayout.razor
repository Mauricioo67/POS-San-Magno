@inherits LayoutComponentBase
@inject IJSRuntime JS

<MudThemeProvider Theme="_currentTheme" @bind-IsDarkMode="_isDarkMode" ObserveSystemDarkModeChange="false" />
<MudPopoverProvider />

@* Needed for dialogs *@
<MudDialogProvider />

@* Needed for snackbars *@
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0" Class="pos-appbar">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       aria-label="Mostrar u ocultar menú" OnClick="DrawerToggle" />
        <div class="pos-brand ml-2">
            <span class="pos-brand-badge">
                <MudIcon Icon="@Icons.Material.Filled.PointOfSale" Size="Size.Small" />
            </span>
            <div>
                <div style="line-height: 1.1;">App POS</div>
                <div style="font-size: .68rem; font-weight: 500; letter-spacing: .16em; opacity: .72; text-transform: uppercase;">
                    San Magno
                </div>
            </div>
        </div>
        <MudSpacer />
        <StockAlertBell />
        <AuthLinks />
        <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                       Color="Color.Inherit" title="Cambiar tema" aria-label="Cambiar tema"
                       OnClick="ToggleThemeAsync" Class="ml-2" />
    </MudAppBar>
    <MudDrawer @bind-Open="_drawerOpen" Variant="DrawerVariant.Responsive" Breakpoint="Breakpoint.Md"
               ClipMode="DrawerClipMode.Always" Elevation="0" Width="272px" Class="pos-drawer">
        <NavMenu />
    </MudDrawer>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-6">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    bool _drawerOpen = true;
    bool _isDarkMode = false;
    bool _themeLoaded = false;
    MudTheme _currentTheme = new MudTheme();

    protected override void OnInitialized()
    {
        _currentTheme = new MudTheme()
            {
                PaletteLight = new PaletteLight()
                {
                    Primary = "#6D28D9",
                    Secondary = "#EC4899",
                    Tertiary = "#06B6D4",
                    Info = "#0EA5E9",
                    Success = "#10B981",
                    Warning = "#F59E0B",
                    Error = "#EF4444",
                    AppbarBackground = "#4F46E5",
                    AppbarText = "#FFFFFF",
                    DrawerBackground = "#FFFFFF",
                    DrawerText = "#1B1533",
                    Background = "#F5F3FF",
                    Surface = "#FFFFFF",
                    TextPrimary = "#1B1533",
                    TextSecondary = "#6B6480",
                    ActionDefault = "#6B6480",
                    Divider = "#ECE9F7",
                    LinesDefault = "#ECE9F7",
                },
                PaletteDark = new PaletteDark()
                {
                    Primary = "#A78BFA",
                    Secondary = "#F472B6",
                    Tertiary = "#22D3EE",
                    Info = "#38BDF8",
                    Success = "#34D399",
                    Warning = "#FBBF24",
                    Error = "#F87171",
                    AppbarBackground = "#171326",
                    AppbarText = "#F5F3FF",
                    DrawerBackground = "#120F1F",
                    DrawerText = "#F5F3FF",
                    Background = "#0C0A16",
                    Surface = "#171326",
                    TextPrimary = "#F5F3FF",
                    TextSecondary = "#A6A0BD",
                    ActionDefault = "#A6A0BD",
                    Divider = "#241E38",
                    LinesDefault = "#241E38",
                },
                Typography = new Typography()
                {
                    Default = new DefaultTypography()
                    {
                        FontFamily = new[] { "Roboto", "Helvetica", "Arial", "sans-serif" }
                    }
                },
                LayoutProperties = new LayoutProperties()
                {
                    DefaultBorderRadius = "12px"
                }
            };
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _themeLoaded)
        {
            return;
        }
        _themeLoaded = true;
        try
        {
            var stored = await JS.InvokeAsync<string?>("localStorage.getItem", "pos_darkmode");
            if (stored == "1")
            {
                _isDarkMode = true;
            }
        }
        catch
        {
            // JS interop no disponible todavía
        }

        await ApplyThemeAsync();
    }

    async Task ToggleThemeAsync()
    {
        _isDarkMode = !_isDarkMode;
        await ApplyThemeAsync();
    }

    async Task ApplyThemeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("posApplyTheme", _isDarkMode);
            await JS.InvokeVoidAsync("localStorage.setItem", "pos_darkmode", _isDarkMode ? "1" : "0");
        }
        catch
        {
            // JS interop no disponible todavía
        }

        StateHasChanged();
    }

    void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }
}

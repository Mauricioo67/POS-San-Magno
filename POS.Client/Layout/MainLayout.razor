@inherits LayoutComponentBase
@inject IJSRuntime JS

<MudThemeProvider Theme="_currentTheme" @bind-IsDarkMode="_isDarkMode" />
<MudPopoverProvider />

@* Needed for dialogs *@
<MudDialogProvider />

@* Needed for snackbars *@
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       aria-label="Mostrar u ocultar menú" OnClick="DrawerToggle" />
        <MudIcon Icon="@Icons.Material.Filled.PointOfSale" Class="ml-2 mr-2" />
        <MudText Typo="Typo.h6" Class="pos-bold">App POS</MudText>
        <MudSpacer />
        <AuthLinks />
        <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                       Color="Color.Inherit" title="Cambiar tema" aria-label="Cambiar tema"
                       OnClick="ToggleThemeAsync" Class="ml-2" />
    </MudAppBar>
    <MudDrawer @bind-Open="_drawerOpen" Variant="DrawerVariant.Responsive" Breakpoint="Breakpoint.Md"
               ClipMode="DrawerClipMode.Always" Elevation="2">
        <NavMenu />
    </MudDrawer>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-6">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    bool _drawerOpen = true;
    bool _isDarkMode = false;
    bool _themeLoaded = false;
    MudTheme _currentTheme = new MudTheme();

    protected override void OnInitialized()
    {
        _currentTheme = new MudTheme()
            {
                PaletteLight = new PaletteLight()
                {
                    Primary = "#4F46E5",
                    Secondary = "#E91E63",
                    AppbarBackground = "#4F46E5",
                    AppbarText = "#FFFFFF",
                    DrawerBackground = "#FFFFFF",
                    Background = "#F4F5FA",
                    Surface = "#FFFFFF",
                },
                PaletteDark = new PaletteDark()
                {
                    Primary = "#818CF8",
                    Secondary = "#F48FB1",
                    AppbarBackground = "#1E1B2E",
                    AppbarText = "#FFFFFF",
                    DrawerBackground = "#151320",
                    Background = "#0F0D17",
                    Surface = "#1A1726",
                },
                Typography = new Typography()
                {
                    Default = new DefaultTypography()
                    {
                        FontFamily = new[] { "Roboto", "Helvetica", "Arial", "sans-serif" }
                    }
                },
                LayoutProperties = new LayoutProperties()
                {
                    DefaultBorderRadius = "6px"
                }
            };
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _themeLoaded)
        {
            return;
        }
        _themeLoaded = true;
        try
        {
            var stored = await JS.InvokeAsync<string?>("localStorage.getItem", "pos_darkmode");
            if (stored == "1")
            {
                _isDarkMode = true;
                StateHasChanged();
            }
        }
        catch
        {
            // JS interop no disponible todavía
        }
    }

    async Task ToggleThemeAsync()
    {
        _isDarkMode = !_isDarkMode;
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", "pos_darkmode", _isDarkMode ? "1" : "0");
        }
        catch
        {
            // JS interop no disponible todavía
        }
    }

    void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }
}
